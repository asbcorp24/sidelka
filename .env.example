APP_NAME="Сиделка24"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Для локальной разработки можно использовать MailHog.
# На сервере замените параметры на SMTP вашего почтового провайдера.
MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@sidelka.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

SUPERADMIN_NAME="Администратор"
SUPERADMIN_EMAIL=admin@sidelka.test
SUPERADMIN_PASSWORD=password
SEED_DEFAULT_PASSWORD=password

VK_CLIENT_ID=
VK_CLIENT_SECRET=
VK_REDIRECT_URI="${APP_URL}/auth/vk/callback"
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI="${APP_URL}/auth/yandex/callback"

# Тестовая среда интернет-эквайринга Сбера.
# Логин и пароль выдаются Сбером и не должны попадать в GitHub.
SBER_ACQUIRING_ENABLED=false
SBER_ACQUIRING_URL=https://ecomtest.sberbank.ru/ecomm/gw/partner/api/v1
SBER_ACQUIRING_USERNAME=
SBER_ACQUIRING_PASSWORD=
SBER_ACQUIRING_TIMEOUT=20
SBER_ACQUIRING_DESCRIPTION="Пополнение баланса Сиделка24"

# Юридические реквизиты площадки/агента. Заполните реальными данными ООО.
LEGAL_COMPANY_NAME="ООО Сиделка24"
LEGAL_COMPANY_SHORT_NAME="Сиделка24"
LEGAL_COMPANY_INN=
LEGAL_COMPANY_KPP=
LEGAL_COMPANY_OGRN=
LEGAL_COMPANY_ADDRESS=
LEGAL_COMPANY_EMAIL="info@sidelka-24.ru"
LEGAL_COMPANY_PHONE=
LEGAL_COMPANY_BANK_NAME=
LEGAL_COMPANY_BANK_BIK=
LEGAL_COMPANY_BANK_ACCOUNT=
LEGAL_COMPANY_CORRESPONDENT_ACCOUNT=
LEGAL_COMPANY_SIGNATORY_NAME=
LEGAL_COMPANY_SIGNATORY_POSITION="Генеральный директор"
LEGAL_COMPANY_SIGNATORY_BASIS="Устава"
LEGAL_AGENT_COMMISSION_PERCENT=10
LEGAL_CONTRACT_VERSION=1
LEGAL_CONTRACT_LIFETIME_DAYS=30

# Простая электронная подпись: auto выбирает SMS.RU, а без него — реальный email.
# Значение log допустимо только для локальной разработки и тестов.
LEGAL_SIGNATURE_CHANNEL=auto
LEGAL_SIGNATURE_CODE_TTL=10
LEGAL_SIGNATURE_MAX_ATTEMPTS=5
SMS_RU_API_ID=
SMS_RU_FROM=
SMS_RU_TEST=true
SMS_RU_URL=https://sms.ru/sms/send
